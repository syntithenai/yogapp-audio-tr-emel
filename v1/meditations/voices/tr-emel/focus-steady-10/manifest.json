      "file": "c012.ogg",
      "durationSec": 4.296
    },
    {
      "index": 13,
      "text": "Nefes alıp verirken burun deliklerindeki nefesi odak noktanız olarak seçin.",
      "file": "c013.ogg",
      "durationSec": 8.904
    },
    {
      "index": 14,
      "text": "Hava hissine bağlı kalın.",
