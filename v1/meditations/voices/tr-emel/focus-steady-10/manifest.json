      "index": 15,
      "text": "[durdur:26]",
      "file": "c015.ogg",
      "durationSec": 4.296
    },
    {
      "index": 16,
      "text": "Her nefes verişinizi birden ona kadar sayın.",
      "file": "c016.ogg",
      "durationSec": 6.504
    },
    {
