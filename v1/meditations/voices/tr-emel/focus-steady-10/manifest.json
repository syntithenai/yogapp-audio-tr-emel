      "durationSec": 6.216
    },
    {
      "index": 4,
      "text": "Yere teması hissedin.",
      "file": "c004.ogg",
      "durationSec": 4.056
    },
    {
      "index": 5,
      "text": "Yavaşça nefes alın.",
