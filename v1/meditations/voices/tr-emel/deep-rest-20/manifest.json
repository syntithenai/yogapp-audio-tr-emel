  "chunks": [
    {
      "index": 0,
      "text": "Derin bir dinlenme uygulamasına hoş geldiniz.",
      "file": "c000.ogg",
      "durationSec": 6.552
    },
    {
      "index": 1,
      "text": "Mümkünse sırt üstü yatarak başlayın.",
      "file": "c001.ogg",
      "durationSec": 5.76
    },
    {
      "index": 2,
      "text": "Eğer yardımcı oluyorsa başı ve dizleri destekleyin.",
      "file": "c002.ogg",
      "durationSec": 6.864
    },
    {
      "index": 3,
      "text": "Kolları yanlarınıza bırakın, avuç içleri rahat olsun.",
      "file": "c003.ogg",
      "durationSec": 7.008
    },
    {
      "index": 4,
      "text": "Gözlerinizi kapatın.",
      "file": "c004.ogg",
      "durationSec": 3.96
    },
    {
      "index": 5,
      "text": "Diğer hiçbir yerde olmak yok.",
      "file": "c005.ogg",
      "durationSec": 5.064
    },
    {
      "index": 6,
      "text": "[durdur:23]",
      "file": "c006.ogg",
      "durationSec": 4.272
    },
    {
      "index": 7,
      "text": "Zemin veya yatağa temas noktalarını hissedin.",
      "file": "c007.ogg",
      "durationSec": 6.312
    },
    {
      "index": 8,
      "text": "Ayak bilekleri. Bel. Omuz bıçakları. Baş.",
      "file": "c008.ogg",
      "durationSec": 11.424
    },
    {
      "index": 9,
      "text": "Vücudunuzun tutulmasına izin verin.",
      "file": "c009.ogg",
      "durationSec": 5.16
    },
    {
      "index": 10,
      "text": "[durdur:23]",
      "file": "c010.ogg",
      "durationSec": 4.272
    },
    {
      "index": 11,
      "text": "Doğal nefesinizi fark edin.",
      "file": "c011.ogg",
      "durationSec": 4.584
    },
    {
      "index": 12,
      "text": "Değiştirmenize gerek yok.",
      "file": "c012.ogg",
      "durationSec": 4.536
    },
    {
      "index": 13,
      "text": "Nefes giriyor.",
      "file": "c013.ogg",
      "durationSec": 3.48
    },
    {
      "index": 14,
      "text": "Nefes çıkıyor.",
      "file": "c014.ogg",
      "durationSec": 3.504
    },
    {
      "index": 15,
      "text": "[durdur:25]",
      "file": "c015.ogg",
      "durationSec": 4.344
    },
    {
      "index": 16,
      "text": "Eğer zihin meşgulse, bu da kabul edilir.",
      "file": "c016.ogg",
      "durationSec": 6.0
    },
    {
      "index": 17,
      "text": "Yine de dinlenin.",
      "file": "c017.ogg",
      "durationSec": 3.6
    },
    {
      "index": 18,
      "text": "Sadece hissetmeye geri dönün.",
      "file": "c018.ogg",
      "durationSec": 4.92
    },
    {
      "index": 19,
      "text": "[durdur:23]",
      "file": "c019.ogg",
      "durationSec": 4.272
    },
    {
      "index": 20,
      "text": "Sağ ayakta farkındalığa getirin.",
      "file": "c020.ogg",
      "durationSec": 5.16
    },
    {
      "index": 21,
      "text": "Parmaklar. Ayak tabanı. Topuk.",
      "file": "c021.ogg",
      "durationSec": 8.544
    },
    {
      "index": 22,
      "text": "[durdur:21]",
      "file": "c022.ogg",
      "durationSec": 4.032
    },
    {
      "index": 23,
      "text": "Sağ alt bacak.",
      "file": "c023.ogg",
      "durationSec": 3.72
    },
    {
      "index": 24,
      "text": "Diz.",
      "file": "c024.ogg",
      "durationSec": 2.496
    },
    {
      "index": 25,
      "text": "Uyluk.",
