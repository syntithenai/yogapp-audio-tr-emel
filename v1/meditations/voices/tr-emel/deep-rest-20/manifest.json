    },
    {
      "index": 59,
      "text": "[bekleme:21]",
      "file": "c059.ogg",
      "durationSec": 4.08
    },
    {
      "index": 60,
      "text": "Gözler kafeslerinde dinleniyor.",
      "file": "c060.ogg",
      "durationSec": 5.184
    },
    {
      "index": 61,
      "text": "Alnınız düz.",
      "file": "c061.ogg",
      "durationSec": 3.336
    },
    {
      "index": 62,
      "text": "Kafa derisi ve başın tepesi.",
      "file": "c062.ogg",
      "durationSec": 4.968
    },
    {
      "index": 63,
      "text": "[bekleme:23]",
      "file": "c063.ogg",
      "durationSec": 4.536
    },
    {
      "index": 64,
      "text": "Tüm bedeni tek bir sessiz alan olarak hisset.",
      "file": "c064.ogg",
      "durationSec": 6.24
    },
    {
      "index": 65,
      "text": "Soluk, hafif bir dalga gibi onu geçiyor.",
      "file": "c065.ogg",
      "durationSec": 5.784
    },
    {
      "index": 66,
      "text": "[bekleme:62]",
      "file": "c066.ogg",
      "durationSec": 4.584
    },
    {
      "index": 67,
      "text": "Tüm bedeniyle kal.",
      "file": "c067.ogg",
      "durationSec": 3.864
    },
    {
      "index": 68,
      "text": "[bekleme:105]",
      "file": "c068.ogg",
      "durationSec": 4.512
    },
    {
      "index": 69,
      "text": "Yumuşak. Geniş. Huzurlu.",
      "file": "c069.ogg",
      "durationSec": 8.376
    },
    {
      "index": 70,
      "text": "[durdur:55]",
      "file": "c070.ogg",
      "durationSec": 4.32
    },
    {
      "index": 71,
      "text": "Bir düşünce belirirse, bir bulut gibi geçmesine izin ver.",
      "file": "c071.ogg",
      "durationSec": 7.608
    },
    {
      "index": 72,
      "text": "[durdur:50]",
      "file": "c072.ogg",
      "durationSec": 3.912
    },
    {
      "index": 73,
      "text": "Sizi tutulmuş hissetmeye geri dönün.",
      "file": "c073.ogg",
      "durationSec": 5.448
    },
    {
      "index": 74,
      "text": "[durdur:55]",
      "file": "c074.ogg",
      "durationSec": 4.32
    },
    {
      "index": 75,
      "text": "Burada dinlenin.",
      "file": "c075.ogg",
      "durationSec": 3.528
    },
    {
      "index": 76,
      "text": "Çözecek bir şey yok.",
      "file": "c076.ogg",
      "durationSec": 3.888
    },
    {
      "index": 77,
      "text": "Tamamlanacak bir şey yok.",
      "file": "c077.ogg",
      "durationSec": 4.296
    },
    {
      "index": 78,
      "text": "[durdur:110]",
      "file": "c078.ogg",
      "durationSec": 4.32
    },
    {
      "index": 79,
      "text": "Sakınacak olursanız, sorun değil.",
      "file": "c079.ogg",
      "durationSec": 5.52
    },
    {
      "index": 80,
      "text": "Uyanık kalırsanız, bu da sorun değil.",
      "file": "c080.ogg",
      "durationSec": 5.688
    },
    {
      "index": 81,
      "text": "İkisi de dinlenmedir.",
      "file": "c081.ogg",
      "durationSec": 4.248
    },
    {
      "index": 82,
      "text": "[durdur:130]",
      "file": "c082.ogg",
      "durationSec": 4.296
    },
    {
      "index": 83,
      "text": "Dinlenin.",
      "file": "c083.ogg",
      "durationSec": 2.904
    },
    {
      "index": 84,
      "text": "[durdur:115]",
      "file": "c084.ogg",
      "durationSec": 4.752
    },
    {
      "index": 85,
      "text": "Tekrar nefes algılamaya başlayın.",
      "file": "c085.ogg",
      "durationSec": 5.208
    },
    {
      "index": 86,
      "text": "Biraz daha canlı hale geldi.",
      "file": "c086.ogg",
      "durationSec": 5.16
    },
    {
      "index": 87,
      "text": "[durdur:23]",
      "file": "c087.ogg",
      "durationSec": 4.272
    },
    {
      "index": 88,
      "text": "Etrafınızdaki odayı hissedin.",
      "file": "c088.ogg",
      "durationSec": 4.776
    },
    {
      "index": 89,
      "text": "Yakın ve uzak sesleri.",
      "file": "c089.ogg",
      "durationSec": 4.56
    },
    {
      "index": 90,
      "text": "[durdur:21]",
      "file": "c090.ogg",
      "durationSec": 4.032
    },
    {
      "index": 91,
      "text": "Parmaklarınızı hareket ettirin.",
      "file": "c091.ogg",
      "durationSec": 4.632
    },
    {
      "index": 92,
      "text": "Ayak parmaklarınızı hareket ettirin.",
      "file": "c092.ogg",
      "durationSec": 5.16
    },
    {
      "index": 93,
      "text": "İsterseniz bilek ve ayak bileklerinizi yuvarlayın.",
      "file": "c093.ogg",
      "durationSec": 6.84
    },
    {
      "index": 94,
      "text": "[durdur:21]",
      "file": "c094.ogg",
      "durationSec": 4.032
    },
    {
      "index": 95,
      "text": "Daha derin bir nefes alın.",
      "file": "c095.ogg",
      "durationSec": 4.392
    },
    {
      "index": 96,
      "text": "Ve uzun bir iç çekin.",
      "file": "c096.ogg",
      "durationSec": 4.224
    },
    {
      "index": 97,
      "text": "Hazır olduğunuzda, gözlerinizi açın.",
      "file": "c097.ogg",
      "durationSec": 5.712
    },
    {
      "index": 98,
      "text": "Yavaşça geri dönün.",
      "file": "c098.ogg",
      "durationSec": 3.984
    },
    {
      "index": 99,
      "text": "Bu sessizliğin birazını yanınızda taşıyın.",
      "file": "c099.ogg",
      "durationSec": 5.928
    }
  ]
