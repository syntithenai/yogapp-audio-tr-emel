      "durationSec": 2.664
    },
    {
      "index": 26,
      "text": "[durdur:21]",
      "file": "c026.ogg",
      "durationSec": 4.032
    },
    {
      "index": 27,
      "text": "Sağ kalça.",
      "file": "c027.ogg",
      "durationSec": 3.264
    },
    {
      "index": 28,
      "text": "Bütün sağ bacak, ağır ve sessiz.",
      "file": "c028.ogg",
