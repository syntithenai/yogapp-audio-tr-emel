{
  "id": "lake-wander-10",
  "voiceId": "tr-emel",
  "edgeVoice": "tr-TR-EmelNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 662,
  "chunks": [
    {
      "index": 0,
      "text": "Hoş geldiniz.",
      "file": "c000.ogg",
      "durationSec": 3.552
    },
    {
      "index": 1,
      "text": "Sizden hiçbir şey istemeyen bir pozisyona bulun.",
      "file": "c001.ogg",
      "durationSec": 6.6
    },
    {
      "index": 2,
      "text": "İhtiyacınız olan herhangi bir destek ile oturun ya da uzanın.",
      "file": "c002.ogg",
      "durationSec": 7.632
    },
    {
      "index": 3,
      "text": "Ellerinizi açık ya da yumuşak bir şekilde dinlenin.",
      "file": "c003.ogg",
      "durationSec": 6.624
    },
    {
      "index": 4,
      "text": "Gözlerinizi kapamaya izin verin ya da yumuşak bir bakış tutun.",
      "file": "c004.ogg",
      "durationSec": 7.68
    },
    {
      "index": 5,
      "text": "Vücudun zemine temas ettiği yerleri hissedin.",
      "file": "c005.ogg",
      "durationSec": 6.216
    },
    {
      "index": 6,
      "text": "Topuklar, oturma kemikleri, başın arkası veya omuzların uzunluğu.",
      "file": "c006.ogg",
      "durationSec": 8.664
    },
    {
      "index": 7,
      "text": "Şimdi hiçbir şey tutmamak gerekir.",
      "file": "c007.ogg",
      "durationSec": 5.4
    },
    {
      "index": 8,
      "text": "Narında hafifçe nefes alın.",
      "file": "c008.ogg",
      "durationSec": 4.632
    },
    {
      "index": 9,
      "text": "Hava soğukluğunu hissedin.",
      "file": "c009.ogg",
      "durationSec": 4.44
    },
    {
      "index": 10,
      "text": "Ve daha uzun bir nefes verin.",
      "file": "c010.ogg",
      "durationSec": 4.776
    },
    {
      "index": 11,
      "text": "Nefesinizin ısınmasını hissedin.",
      "file": "c011.ogg",
      "durationSec": 4.968
    },
    {
      "index": 12,
      "text": "Tekrar. Hafif nefes alın.",
      "file": "c012.ogg",
      "durationSec": 6.312
    },
    {
      "index": 13,
      "text": "Hızlı olmayan nefes verin.",
      "file": "c013.ogg",
      "durationSec": 4.584
    },
    {
      "index": 14,
      "text": "Omuzlarınızı biraz düşürün.",
      "file": "c014.ogg",
      "durationSec": 4.608
    },
    {
      "index": 15,
      "text": "Dişlerinizin sıkışmasını bırakın.",
      "file": "c015.ogg",
      "durationSec": 5.088
    },
    {
      "index": 16,
      "text": "Belly'nizi yumuşak tutun.",
      "file": "c016.ogg",
      "durationSec": 4.344
    },
    {
      "index": 17,
      "text": "Sadece bu şekilde üç sessiz nefes alın ve durun.",
      "file": "c017.ogg",
      "durationSec": 6.864
    },
    {
      "index": 18,
      "text": "Nefes alın. Gelin.",
      "file": "c018.ogg",
      "durationSec": 5.592
    },
    {
      "index": 19,
      "text": "Nefes verin. Oturun.",
      "file": "c019.ogg",
      "durationSec": 5.808
    },
    {
      "index": 20,
      "text": "Eğer zihnin dolaşıyorsa, nazikçe fark edin ve bu nefese geri dönün.",
      "file": "c020.ogg",
      "durationSec": 8.784
    },
    {
      "index": 21,
      "text": "Bir geniş sessiz gölün kıyısında uyanıyor gibi hayal edin.",
      "file": "c021.ogg",
      "durationSec": 7.32
    },
    {
      "index": 22,
      "text": "Sabah ışığı suyun üzerinde yumuşak bir şekilde duruyor.",
      "file": "c022.ogg",
      "durationSec": 7.08
    },
    {
      "index": 23,
      "text": "Soğuk hava yüzünüzde temiz ve taze bir dokunuş yapıyor.",
      "file": "c023.ogg",
      "durationSec": 7.392
    },
    {
      "index": 24,
      "text": "İlk güneş ayaklarınızın tepelerini ısıtır.",
      "file": "c024.ogg",
      "durationSec": 5.952
    },
    {
      "index": 25,
      "text": "Sakin bir şekilde kıyı boyunca yürümeye başlarsınız.",
      "file": "c025.ogg",
      "durationSec": 7.224
    },
    {
      "index": 26,
      "text": "Kum ve küçük yumuşak taşlar ayaklarınız altında hafifçe kayar.",
      "file": "c026.ogg",
      "durationSec": 7.896
    },
    {
      "index": 27,
      "text": "Her adım, toprağa sessiz bir konuşma yapar.",
      "file": "c027.ogg",
      "durationSec": 6.096
    },
    {
      "index": 28,
      "text": "Su üzerinden bir rüzgar gelir — taze ve hafif soğuk.",
      "file": "c028.ogg",
      "durationSec": 7.368
    },
    {
      "index": 29,
      "text": "Kafa kapağınızın saçlarını kaldırır.",
      "file": "c029.ogg",
      "durationSec": 5.448
    },
    {
      "index": 30,
      "text": "Kedek kokusu, ıslak kayalar ve açık sabahı hissedin.",
      "file": "c030.ogg",
      "durationSec": 7.056
    },
    {
      "index": 31,
      "text": "Bir karaçamın suyunun derinliklerinde durduğunu, tamamen sessiz olduğunu gözlemleyin.",
      "file": "c031.ogg",
      "durationSec": 9.792
    },
    {
      "index": 32,
      "text": "Birkaç nefes boyunca o sessizliği eşleyin.",
      "file": "c032.ogg",
      "durationSec": 6.384
    },
    {
      "index": 33,
      "text": "Gündüz yükseldikçe omuzlarınıza ısınma hissi geliyor.",
      "file": "c033.ogg",
      "durationSec": 7.2
    },
    {
      "index": 34,
      "text": "Bir güneşli kayayı bulun ve oturun.",
      "file": "c034.ogg",
      "durationSec": 5.256
    },
    {
      "index": 35,
      "text": "Kaya içinde saklanan ısının vücudunuza yükseldiğini hissedin.",
      "file": "c035.ogg",
      "durationSec": 7.56
    },
    {
      "index": 36,
      "text": "Her nefesinizde daha taze hava dudaklarınızın üzerinden geçtiğini hissedin.",
      "file": "c036.ogg",
      "durationSec": 9.12
    },
    {
      "index": 37,
      "text": "Gölün yüzeyi kıvrılarak, tekrar cam gibi olur.",
      "file": "c037.ogg",
      "durationSec": 6.576
    },
    {
      "index": 38,
      "text": "O yerde ışık sessiz mutluluk gibi titrer.",
      "file": "c038.ogg",
      "durationSec": 6.096
    },
    {
      "index": 39,
      "text": "Kıyının bir kıvrımını takip ederek küçük bir körfeze doğru ilerleyin.",
      "file": "c039.ogg",
      "durationSec": 7.992
    },
    {
      "index": 40,
      "text": "Çalılar fısıldar. Su, ahşap üzerine yumuşakça çırpar.",
      "file": "c040.ogg",
      "durationSec": 9.504
    },
    {
      "index": 41,
      "text": "Eski bir körfez uzanıyor. Sonuna doğru yürüyün.",
      "file": "c041.ogg",
      "durationSec": 8.568
    },
    {
      "index": 42,
      "text": "Ayaklarınızın soğuk suyun üzerinde sallandığı yerde oturun.",
      "file": "c042.ogg",
      "durationSec": 7.56
    },
    {
      "index": 43,
      "text": "Omuzlarınıza güneş, bacaklarınıza rüzgar.",
      "file": "c043.ogg",
      "durationSec": 6.312
    },
    {
      "index": 44,
      "text": "Bir ayak ucu daldırın. Yumuşak soğukluk. Gözüne gerek duymadığınız bir gülümseme.",
      "file": "c044.ogg",
      "durationSec": 13.2
    },
    {
      "index": 45,
      "text": "Isıtılmış ahşaplar üzerine sıyırın.",
      "file": "c045.ogg",
      "durationSec": 5.376
    },
    {
      "index": 46,
      "text": "Altında suyu, üzerinde gökyüzünü dinleyin.",
      "file": "c046.ogg",
      "durationSec": 6.024
    },
    {
      "index": 47,
      "text": "Nefesiniz, gölün genişliği kadar olur.",
      "file": "c047.ogg",
      "durationSec": 5.568
    },
    {
      "index": 48,
      "text": "Taze hava alın. Sonsuz maviye nefes verin.",
      "file": "c048.ogg",
      "durationSec": 8.472
    },
    {
      "index": 49,
      "text": "Çözmem gereken hiçbir şey yok. Sadece bu ısınma, bu hava, bu sükûnet.",
      "file": "c049.ogg",
      "durationSec": 11.256
    },
    {
      "index": 50,
      "text": "Körfezin ısısını sırtınız boyunca hissedin.",
      "file": "c050.ogg",
      "durationSec": 6.072
    },
    {
      "index": 51,
      "text": "Rüzgarın dönmesiyle her seferinde daha soğuk bir hava bandı hissedin.",
      "file": "c051.ogg",
      "durationSec": 8.352
    },
    {
      "index": 52,
      "text": "Bir damar yarısı havayı dikiyor ve kayboluyor.",
      "file": "c052.ogg",
      "durationSec": 6.72
    },
    {
      "index": 53,
      "text": "Duyguyu kaslar ve kemiklere kadar gömene kadar kalın.",
      "file": "c053.ogg",
      "durationSec": 7.032
    },
    {
      "index": 54,
      "text": "Eğer zihin görevleri düşünüyorsa, bunları şu an için uzak kıyıya bırakın.",
      "file": "c054.ogg",
      "durationSec": 9.048
    },
    {
      "index": 55,
      "text": "Bekleyebilirler. Göl, hiçbir şey beklemiyor.",
      "file": "c055.ogg",
      "durationSec": 8.448
    },
    {
      "index": 56,
      "text": "Bir eli karın üstünde. Yüksel. Düş.",
      "file": "c056.ogg",
      "durationSec": 9.192
    },
    {
      "index": 57,
      "text": "Diğer elin palman altında odunun ısısı.",
      "file": "c057.ogg",
      "durationSec": 5.88
    },
    {
      "index": 58,
      "text": "Bu çift tutuşma — beden ve yer — içinde dinlen.",
      "file": "c058.ogg",
      "durationSec": 6.768
    },
    {
      "index": 59,
      "text": "Daha fazla hayal kurgusunda ayakta yürü.",
      "file": "c059.ogg",
      "durationSec": 6.0
    },
    {
      "index": 60,
      "text": "Kayaçlar yumuşak bir şekilde çalıyor. Düşmüş dalın yanında su parlaklaşıyor.",
      "file": "c060.ogg",
      "durationSec": 11.256
    },
    {
      "index": 61,
      "text": "Gün, boyun arkasında dostça ısıyla bulunuyor.",
      "file": "c061.ogg",
      "durationSec": 6.624
    },
    {
      "index": 62,
      "text": "Kızılderili gölgesi, birkaç adım için yanınızı soğutuyor.",
      "file": "c062.ogg",
      "durationSec": 7.608
    },
    {
      "index": 63,
      "text": "Sıcaklık ve taze hava değişimi, yürüyüşün bir dua haline geliyor.",
      "file": "c063.ogg",
      "durationSec": 8.616
    },
    {
      "index": 64,
      "text": "Kelimeler gerekmez. Sadece his ve nefes.",
      "file": "c064.ogg",
      "durationSec": 8.544
    },
    {
      "index": 65,
      "text": "Isıtılmış bir kum yeri bulup açık suya dönük oturun.",
      "file": "c065.ogg",
      "durationSec": 6.72
    },
    {
      "index": 66,
      "text": "Gözlerinizi ufuk çizgisi üzerinde yumuşatın.",
      "file": "c066.ogg",
      "durationSec": 6.384
    },
    {
      "index": 67,
      "text": "Gölün soğuk kokusunu nefes alın.",
      "file": "c067.ogg",
      "durationSec": 4.944
    },
    {
      "index": 68,
      "text": "Uzak dağlara doğru nefes verin.",
      "file": "c068.ogg",
      "durationSec": 5.064
    },
    {
      "index": 69,
      "text": "Buraya getirdiğiniz her şey, yanınızda kıyıya bırakabilirsiniz.",
      "file": "c069.ogg",
      "durationSec": 8.112
    },
    {
      "index": 70,
      "text": "Suyun içinde taşınması gerekmez.",
      "file": "c070.ogg",
      "durationSec": 5.664
    },
    {
      "index": 71,
      "text": "Bir sonraki üç nefes hissedilene kadar kalın.",
      "file": "c071.ogg",
      "durationSec": 6.48
    },
    {
      "index": 72,
      "text": "Şimdi hikayeyi bırakın ve hissetmeye devam edin.",
      "file": "c072.ogg",
      "durationSec": 6.672
    },
    {
      "index": 73,
      "text": "Bu yerin tazeliğini nefes alın.",
      "file": "c073.ogg",
      "durationSec": 4.944
    },
    {
      "index": 74,
      "text": "Isı ve sessizliğe nefes verin.",
      "file": "c074.ogg",
      "durationSec": 5.16
    },
    {
      "index": 75,
      "text": "Nefes alın.",
      "file": "c075.ogg",
      "durationSec": 3.096
    },
    {
      "index": 76,
      "text": "Nefes verin.",
      "file": "c076.ogg",
      "durationSec": 3.24
    },
    {
      "index": 77,
      "text": "Tekrar. Yumuşak nefes alın.",
      "file": "c077.ogg",
      "durationSec": 6.504
    },
    {
      "index": 78,
      "text": "Daha uzun nefes verin.",
      "file": "c078.ogg",
      "durationSec": 4.248
    },
    {
      "index": 79,
      "text": "Bu hayal kurgusunun zeminiyle bedeninizin tutulduğunu hissedin.",
      "file": "c079.ogg",
      "durationSec": 7.512
    },
    {
      "index": 80,
      "text": "Nefes alın.",
      "file": "c080.ogg",
      "durationSec": 3.096
    },
    {
      "index": 81,
      "text": "Nefes verin.",
      "file": "c081.ogg",
      "durationSec": 3.24
    },
    {
      "index": 82,
      "text": "Eğer düşünceler dağılırsa, ciltteki sıcaklığa geri dönün.",
      "file": "c082.ogg",
      "durationSec": 7.536
    },
    {
      "index": 83,
      "text": "Ya da burunda soğuk havaya.",
      "file": "c083.ogg",
      "durationSec": 4.56
    },
    {
      "index": 84,
      "text": "Nefes alın.",
      "file": "c084.ogg",
      "durationSec": 3.096
    },
    {
      "index": 85,
      "text": "Nefes verin.",
      "file": "c085.ogg",
      "durationSec": 3.24
    },
    {
      "index": 86,
      "text": "Nefes alın.",
      "file": "c086.ogg",
      "durationSec": 3.096
    },
    {
      "index": 87,
      "text": "Nefes verin.",
      "file": "c087.ogg",
      "durationSec": 3.24
    },
    {
      "index": 88,
      "text": "Kalmak. Yumuşamak. Devam etmek.",
      "file": "c088.ogg",
      "durationSec": 9.264
    },
    {
      "index": 89,
      "text": "Nefes alın.",
      "file": "c089.ogg",
      "durationSec": 3.096
    },
    {
      "index": 90,
      "text": "Nefes verin.",
      "file": "c090.ogg",
      "durationSec": 3.24
    },
    {
      "index": 91,
      "text": "Bir sonraki rahat döngü.",
      "file": "c091.ogg",
      "durationSec": 4.56
    },
    {
      "index": 92,
      "text": "Nefes alın.",
      "file": "c092.ogg",
      "durationSec": 3.096
    },
    {
      "index": 93,
      "text": "Nefes verin.",
      "file": "c093.ogg",
      "durationSec": 3.24
    },
    {
      "index": 94,
      "text": "Bu hissi birkaç nefes daha sürün.",
      "file": "c094.ogg",
      "durationSec": 5.472
    },
    {
      "index": 95,
      "text": "Sıcaklık. Yumuşaklık. Yeterlilik.",
      "file": "c095.ogg",
      "durationSec": 9.096
    },
    {
      "index": 96,
      "text": "İhtiyacınız olduğunda bu yere geri dönebilirsiniz.",
      "file": "c096.ogg",
      "durationSec": 6.84
    },
    {
      "index": 97,
      "text": "Bu, sadece hayalde değil, dikkatinizde yaşar.",
      "file": "c097.ogg",
      "durationSec": 6.792
    },
    {
      "index": 98,
      "text": "Nefes almayı derinleştirin.",
      "file": "c098.ogg",
      "durationSec": 4.536
    },
    {
      "index": 99,
      "text": "Yine etrafınızdaki odayı hissedin.",
      "file": "c099.ogg",
      "durationSec": 5.184
    },
    {
      "index": 100,
      "text": "Parmakları sallayın. Ayak parmaklarını gevşetin.",
      "file": "c100.ogg",
      "durationSec": 8.256
    },
    {
      "index": 101,
      "text": "Hazır olduğunuzda, gözlerinizi açın.",
      "file": "c101.ogg",
      "durationSec": 5.712
    },
    {
      "index": 102,
      "text": "Bir sonraki rahat nefes alın.",
      "file": "c102.ogg",
      "durationSec": 4.944
    },
    {
      "index": 103,
      "text": "Bu sakinliği, ne gelirse gelsin, yanınızda taşıyın.",
      "file": "c103.ogg",
      "durationSec": 7.152
    }
  ]
}
