      "durationSec": 2.76
    },
    {
      "index": 9,
      "text": "[durdur:27]",
      "file": "c009.ogg",
      "durationSec": 4.344
    },
    {
      "index": 10,
      "text": "Omuzları düşürün.",
      "file": "c010.ogg",
      "durationSec": 3.6
    },
    {
      "index": 11,
      "text": "Karnı yumuşatın.",
