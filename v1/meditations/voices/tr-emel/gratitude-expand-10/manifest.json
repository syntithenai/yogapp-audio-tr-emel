    },
    {
      "index": 2,
      "text": "Destekle oturun veya yatın.",
      "file": "c002.ogg",
      "durationSec": 4.944
    },
    {
      "index": 3,
      "text": "Güvenli geliyorsa gözlerinizi kapatın.",
