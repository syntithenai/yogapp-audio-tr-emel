      "durationSec": 5.616
    },
    {
      "index": 4,
      "text": "Yerle teması hissedin.",
      "file": "c004.ogg",
      "durationSec": 4.2
    },
    {
      "index": 5,
      "text": "Yavaş nefes alın.",
      "file": "c005.ogg",
      "durationSec": 3.864
    },
    {
      "index": 6,
      "text": "Uzun nefes verin.",
