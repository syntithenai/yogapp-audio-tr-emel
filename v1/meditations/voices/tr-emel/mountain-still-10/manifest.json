  "chunks": [
    {
      "index": 0,
      "text": "Hoş geldiniz.",
      "file": "c000.ogg",
      "durationSec": 3.552
    },
    {
      "index": 1,
      "text": "Varış için zaman ayırın.",
      "file": "c001.ogg",
      "durationSec": 4.296
    },
    {
      "index": 2,
      "text": "Destekle oturun veya yatın.",
      "file": "c002.ogg",
      "durationSec": 4.944
    },
    {
      "index": 3,
      "text": "Güvenli hissediyorsanız gözlerinizi kapatın.",
      "file": "c003.ogg",
      "durationSec": 6.216
    },
    {
      "index": 4,
      "text": "Yere teması hissedin.",
      "file": "c004.ogg",
      "durationSec": 4.056
    },
    {
      "index": 5,
      "text": "Yavaş nefes alın.",
      "file": "c005.ogg",
      "durationSec": 3.864
    },
    {
      "index": 6,
      "text": "Uzun nefes verin.",
      "file": "c006.ogg",
      "durationSec": 3.72
    },
    {
      "index": 7,
      "text": "[durdur:28]",
      "file": "c007.ogg",
      "durationSec": 4.464
    },
    {
      "index": 8,
      "text": "Tekrar.",
      "file": "c008.ogg",
      "durationSec": 2.76
    },
    {
      "index": 9,
      "text": "[durdur:28]",
      "file": "c009.ogg",
      "durationSec": 4.464
    },
    {
      "index": 10,
      "text": "Omuzlarınızı düşürün.",
      "file": "c010.ogg",
      "durationSec": 3.96
    },
    {
      "index": 11,
      "text": "Karnınızı gevşetin.",
      "file": "c011.ogg",
      "durationSec": 3.936
    },
    {
      "index": 12,
      "text": "[durdur:36]",
      "file": "c012.ogg",
      "durationSec": 4.296
    },
    {
      "index": 13,
      "text": "Kendinizi bir dağ gibi hayal edin.",
      "file": "c013.ogg",
      "durationSec": 4.968
    },
    {
      "index": 14,
      "text": "Taban geniş. Zirve sessiz. Büyük sabır.",
      "file": "c014.ogg",
      "durationSec": 9.84
    },
    {
      "index": 15,
      "text": "[durdur:43]",
      "file": "c015.ogg",
      "durationSec": 4.128
    },
    {
      "index": 16,
      "text": "Hava, dağın üzerinden geçer.",
      "file": "c016.ogg",
      "durationSec": 5.016
    },
    {
      "index": 17,
      "text": "Güneş. Rüzgar. Bulut. Fırtına.",
      "file": "c017.ogg",
      "durationSec": 10.848
    },
    {
      "index": 18,
      "text": "Dağ durmaya devam eder.",
      "file": "c018.ogg",
      "durationSec": 4.344
    },
    {
      "index": 19,
      "text": "[durdur:57]",
      "file": "c019.ogg",
      "durationSec": 4.272
    },
    {
      "index": 20,
      "text": "Düşünceler ve ruh halleri havadır.",
      "file": "c020.ogg",
      "durationSec": 5.424
    },
    {
      "index": 21,
      "text": "Sen dağsın.",
      "file": "c021.ogg",
      "durationSec": 3.432
    },
    {
      "index": 22,
      "text": "[durdur:57]",
      "file": "c022.ogg",
      "durationSec": 4.272
    },
    {
      "index": 23,
      "text": "Vücudunun tabanının köklenmiş olduğunu hissedin.",
      "file": "c023.ogg",
      "durationSec": 6.312
    },
    {
      "index": 24,
      "text": "Sırt kemiklerinde gerilme olmadan yükseklik hissedin.",
      "file": "c024.ogg",
      "durationSec": 6.864
    },
    {
      "index": 25,
      "text": "[durdur:43]",
      "file": "c025.ogg",
      "durationSec": 4.128
    },
    {
      "index": 26,
      "text": "Dağın etrafındaki gökyüzü gibi nefes alın.",
      "file": "c026.ogg",
      "durationSec": 6.0
    },
    {
      "index": 27,
      "text": "[durdur:71]",
      "file": "c027.ogg",
      "durationSec": 4.128
    },
    {
      "index": 28,
      "text": "Durgun. Acelesiz. Yeterli.",
      "file": "c028.ogg",
      "durationSec": 8.64
    },
    {
      "index": 29,
      "text": "[durdur:90]",
      "file": "c029.ogg",
      "durationSec": 4.104
    },
    {
      "index": 30,
      "text": "[durdur:43]",
      "file": "c030.ogg",
      "durationSec": 4.128
    },
    {
      "index": 31,
      "text": "Nefes almayı derinleştirmeye başlayın.",
      "file": "c031.ogg",
      "durationSec": 5.568
    },
    {
      "index": 32,
      "text": "Yine odayı hissedin.",
      "file": "c032.ogg",
      "durationSec": 4.008
    },
    {
      "index": 33,
      "text": "Parmakları ve ayak parmaklarını kıvırın.",
      "file": "c033.ogg",
      "durationSec": 5.664
    },
    {
      "index": 34,
      "text": "Hazır olduğunuzda, gözlerinizi açın.",
      "file": "c034.ogg",
      "durationSec": 5.712
    },
    {
      "index": 35,
      "text": "Bir sonraki adıma yavaşça geçin.",
      "file": "c035.ogg",
