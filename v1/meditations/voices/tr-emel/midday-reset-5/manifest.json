    {
      "index": 0,
      "text": "Hoş geldiniz.",
      "file": "c000.ogg",
      "durationSec": 3.552
    },
    {
      "index": 1,
      "text": "Rahat bir oturma pozisyonu alın, daha iyi hissediyorsanız uzanın.",
      "file": "c001.ogg",
      "durationSec": 8.136
    },
    {
      "index": 2,
      "text": "Ellerinizi rahat bırakın.",
      "file": "c002.ogg",
      "durationSec": 4.488
    },
    {
      "index": 3,
      "text": "Gözleri yumuşatın, ya da kapayın.",
      "file": "c003.ogg",
      "durationSec": 5.352
    },
    {
      "index": 4,
      "text": "Yavaşça bir nefes alın.",
      "file": "c004.ogg",
      "durationSec": 4.2
    },
    {
      "index": 5,
      "text": "Ve daha uzun bir nefes verin.",
      "file": "c005.ogg",
      "durationSec": 4.776
    },
    {
      "index": 6,
      "text": "Günün bu noktasında sabahı bitirin, gün devam etse bile.",
      "file": "c006.ogg",
      "durationSec": 7.296
    },
    {
      "index": 7,
      "text": "Omuzlarınızı indirin.",
      "file": "c007.ogg",
      "durationSec": 3.936
    },
    {
      "index": 8,
      "text": "Çeneyi gevşetin.",
      "file": "c008.ogg",
      "durationSec": 3.504
    },
    {
      "index": 9,
      "text": "[durdur:30]",
      "file": "c009.ogg",
      "durationSec": 3.912
    },
    {
      "index": 10,
      "text": "Burundan nefes alın.",
      "file": "c010.ogg",
      "durationSec": 3.96
    },
    {
      "index": 11,
      "text": "Ağızdan nefes verin, bir pencereyi buharlaştırmak gibi.",
      "file": "c011.ogg",
      "durationSec": 7.272
    },
    {
      "index": 12,
      "text": "Tekrar.",
      "file": "c012.ogg",
      "durationSec": 2.76
    },
    {
      "index": 13,
      "text": "[durdur:30]",
      "file": "c013.ogg",
      "durationSec": 3.912
    },
    {
      "index": 14,
      "text": "Ne taşıdığınızı bırakarak hayal edin.",
      "file": "c014.ogg",
      "durationSec": 5.28
    },
    {
      "index": 15,
      "text": "Yanınızdaki masada bekleyebilir.",
      "file": "c015.ogg",
      "durationSec": 4.944
    },
    {
      "index": 16,
      "text": "[durdur:37]",
      "file": "c016.ogg",
      "durationSec": 4.368
    },
    {
      "index": 17,
      "text": "Omurganızın dik olduğunu hissedin.",
      "file": "c017.ogg",
      "durationSec": 5.064
    },
    {
      "index": 18,
      "text": "Karnınızın yumuşak olduğunu hissedin.",
      "file": "c018.ogg",
      "durationSec": 5.328
    },
    {
      "index": 19,
      "text": "[durdur:30]",
      "file": "c019.ogg",
      "durationSec": 3.912
    },
    {
      "index": 20,
      "text": "Sessizce sorun: önümüzdeki saatte ne önemli?",
      "file": "c020.ogg",
      "durationSec": 6.768
    },
    {
      "index": 21,
      "text": "Bir net sonraki adım yeterli.",
      "file": "c021.ogg",
      "durationSec": 4.992
    },
    {
      "index": 22,
      "text": "[durdur:44]",
      "file": "c022.ogg",
      "durationSec": 4.056
    },
    {
      "index": 23,
      "text": "O sadeliği içeri çek.",
      "file": "c023.ogg",
      "durationSec": 4.248
    },
    {
      "index": 24,
      "text": "Çaba dışarıya exhale.",
      "file": "c024.ogg",
      "durationSec": 4.368
    },
    {
      "index": 25,
      "text": "[durdur:37]",
      "file": "c025.ogg",
      "durationSec": 4.368
    },
    {
      "index": 26,
      "text": "Bir tane daha kolay nefes alın.",
      "file": "c026.ogg",
      "durationSec": 5.16
    },
    {
      "index": 27,
      "text": "Parmakları sallayın.",
      "file": "c027.ogg",
      "durationSec": 3.864
    },
    {
      "index": 28,
      "text": "Hazır olduğunuzda, gözlerinizi açın.",
      "file": "c028.ogg",
      "durationSec": 5.712
    },
    {
      "index": 29,
      "text": "Biraz bunu yanınızda taşıyın.",
